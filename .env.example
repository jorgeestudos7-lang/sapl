PORT=3000
SECRET_KEY=replace-with-your-secret-key
DEBUG=False
SITE_URL=
TZ=America/Sao_Paulo

# Database (original Django PostgreSQL config; mocked in-memory in AI Studio unless Cloud SQL is provisioned)
DATABASE_URL=postgresql://postgres:@sapldb:/sapl

# Search (Solr)
USE_SOLR=False
SOLR_URL=http://localhost:8983
SOLR_COLLECTION=sapl

# Email / SMTP
EMAIL_USE_TLS=True
EMAIL_PORT=587
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_SEND_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# Rate limiting & API
RATE_LIMITER_RATE=35/m
API_THROTTLE_ANON=300/min
API_NUM_PROXIES=
LOGGING_CONSOLE_VERBOSE=False
