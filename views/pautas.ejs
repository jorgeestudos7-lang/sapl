<%- include('partials/header') %>

<h1 class="page-header">Pautas das Sessões</h1>
<p class="text-muted">Consulte as matérias pautadas para deliberação nas sessões plenárias.</p>

<% pautas.forEach(p => { %>
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <a href="/sessao/<%= p.sessao.id %>" class="font-weight-bold"><%= p.sessao.__str__ %></a>
      <span class="small text-muted"><%= p.sessao.data_inicio %> às <%= p.sessao.hora_inicio %></span>
    </div>
    <div class="card-body">
      <h6>Ordem do Dia</h6>
      <% if (p.ordem_dia.length === 0) { %>
        <p class="text-muted small">Sem matérias na Ordem do Dia.</p>
      <% } else { %>
        <ul class="mb-3">
          <% p.ordem_dia.forEach(o => { %>
            <li>
              <% if (o.materia) { %>
                <a href="/materia/<%= o.materia.id %>" class="font-weight-bold"><%= o.materia.tipo_sigla %> <%= o.materia.numero %>/<%= o.materia.ano %></a> — <%= o.materia.ementa %>
              <% } %>
              <span class="badge badge-light border ml-1"><%= o.resultado %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <h6>Expediente</h6>
      <% if (p.expediente.length === 0) { %>
        <p class="text-muted small mb-0">Sem matérias no Expediente.</p>
      <% } else { %>
        <ul class="mb-0">
          <% p.expediente.forEach(e => { %>
            <li>
              <% if (e.materia) { %>
                <a href="/materia/<%= e.materia.id %>" class="font-weight-bold"><%= e.materia.tipo_sigla %> <%= e.materia.numero %>/<%= e.materia.ano %></a> — <%= e.materia.ementa %>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>
<% }) %>

<%- include('partials/footer') %>
