<%- include('partials/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
  <div>
    <h1 class="page-header mb-1">Normas Jurídicas</h1>
    <p class="text-muted mb-0">Legislação municipal e textos articulados compilados.</p>
  </div>
  <button class="btn btn-success btn-sm" type="button" data-toggle="collapse" data-target="#novaNormaForm">
    <i class="fas fa-plus mr-1"></i> Nova Norma
  </button>
</div>

<div class="collapse mb-4" id="novaNormaForm">
  <div class="card border-success">
    <div class="card-header bg-success text-white font-weight-bold">Cadastrar Norma Jurídica</div>
    <div class="card-body">
      <form method="POST" action="/norma/create">
        <div class="row">
          <div class="col-md-4 mb-2">
            <label class="font-weight-bold">Tipo</label>
            <select name="tipo_id" class="form-control">
              <% tiposNorma.forEach(t => { %>
                <option value="<%= t.id %>"><%= t.sigla %> — <%= t.descricao %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-2 mb-2">
            <label class="font-weight-bold">Número</label>
            <input type="text" name="numero" class="form-control" placeholder="Auto">
          </div>
          <div class="col-md-2 mb-2">
            <label class="font-weight-bold">Ano</label>
            <input type="number" name="ano" class="form-control" value="2026">
          </div>
          <div class="col-md-4 mb-2">
            <label class="font-weight-bold">Assuntos</label>
            <input type="text" name="assunto" class="form-control" placeholder="Ex: Educação, Finanças">
          </div>
        </div>
        <div class="form-group mt-2">
          <label class="font-weight-bold">Ementa</label>
          <textarea name="ementa" class="form-control" rows="2" required></textarea>
        </div>
        <div class="form-group">
          <label class="font-weight-bold">Texto Inicial (Art. 1º)</label>
          <textarea name="texto" class="form-control" rows="2"></textarea>
        </div>
        <button type="submit" class="btn btn-success btn-sm">Salvar Norma</button>
      </form>
    </div>
  </div>
</div>

<form method="GET" action="/norma/pesquisar" class="card card-body mb-4">
  <div class="row align-items-end">
    <div class="col-md-3 mb-2">
      <label class="font-weight-bold mb-1">Tipo</label>
      <select name="tipo" class="form-control">
        <option value="">Todos</option>
        <% tiposNorma.forEach(t => { %>
          <option value="<%= t.id %>" <%= String(filters.tipo) === String(t.id) ? 'selected' : '' %>><%= t.descricao %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-2 mb-2">
      <label class="font-weight-bold mb-1">Número</label>
      <input type="text" name="numero" value="<%= filters.numero %>" class="form-control" placeholder="Ex: 1420">
    </div>
    <div class="col-md-2 mb-2">
      <label class="font-weight-bold mb-1">Ano</label>
      <input type="text" name="ano" value="<%= filters.ano %>" class="form-control" placeholder="Ex: 2026">
    </div>
    <div class="col-md-3 mb-2">
      <label class="font-weight-bold mb-1">Ementa</label>
      <input type="text" name="ementa" value="<%= filters.ementa %>" class="form-control" placeholder="Palavra-chave...">
    </div>
    <div class="col-md-2 mb-2">
      <button type="submit" class="btn btn-primary btn-block">Pesquisar</button>
    </div>
  </div>
</form>

<p class="text-muted">Foram encontradas <strong><%= normas.length %></strong> norma(s) jurídica(s).</p>

<div class="list-group">
  <% normas.forEach(n => { %>
    <div class="list-group-item">
      <div class="d-flex justify-content-between align-items-center mb-1">
        <h5 class="mb-0">
          <a href="/norma/<%= n.id %>"><%= n.tipo_descricao %> nº <%= n.numero %>/<%= n.ano %></a>
        </h5>
        <span class="badge badge-info"><%= n.esfera_federacao %></span>
      </div>
      <p class="mb-1"><%= n.ementa %></p>
      <small class="text-muted">Data: <%= n.data %> • Publicação: <%= n.data_publicacao %> • Assuntos: <%= n.assuntos.join(', ') %></small>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
