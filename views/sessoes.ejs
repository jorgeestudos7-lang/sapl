<%- include('partials/header') %>

<h1 class="page-header">Sessões Plenárias</h1>
<p class="text-muted">Consulte as sessões plenárias, listas de presença, ordens do dia, votações e painéis.</p>

<form method="GET" action="/sessao/pesquisar-sessao" class="card card-body mb-4">
  <div class="row align-items-end">
    <div class="col-md-4 mb-2">
      <label class="font-weight-bold mb-1">Ano</label>
      <input type="text" name="ano" value="<%= filters.ano %>" class="form-control" placeholder="Ex: 2026">
    </div>
    <div class="col-md-4 mb-2">
      <label class="font-weight-bold mb-1">Tipo</label>
      <select name="tipo" class="form-control">
        <option value="">Todos</option>
        <option value="Ordinária" <%= filters.tipo === 'Ordinária' ? 'selected' : '' %>>Ordinária</option>
        <option value="Extraordinária" <%= filters.tipo === 'Extraordinária' ? 'selected' : '' %>>Extraordinária</option>
        <option value="Solene" <%= filters.tipo === 'Solene' ? 'selected' : '' %>>Solene</option>
      </select>
    </div>
    <div class="col-md-4 mb-2">
      <button type="submit" class="btn btn-primary btn-block">Pesquisar</button>
    </div>
  </div>
</form>

<div class="list-group">
  <% sessoes.forEach(s => { %>
    <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center">
      <div>
        <h5 class="mb-1"><a href="/sessao/<%= s.id %>"><%= s.__str__ %></a></h5>
        <small class="text-muted">
          Data: <strong><%= s.data_inicio %></strong> • Início: <%= s.hora_inicio %> •
          Presentes: <strong><%= s.presentes_ids.length %></strong> parlamentares
        </small>
      </div>
      <div class="mt-2 mt-md-0">
        <span class="badge <%= s.finalizada ? 'badge-secondary' : 'badge-success' %> mr-2">
          <%= s.finalizada ? 'Finalizada' : 'Em Andamento' %>
        </span>
        <a href="/painel-principal/<%= s.id %>" class="btn btn-sm btn-outline-dark">
          <i class="fas fa-tv mr-1"></i> Painel
        </a>
      </div>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
