<%- include('partials/header') %>

<h1 class="page-header">Comissões</h1>
<p class="text-muted">Comissões Permanentes e Temporárias da Casa Legislativa.</p>

<form method="GET" action="/comissao/" class="card card-body mb-4">
  <div class="row align-items-end">
    <div class="col-md-5 mb-2">
      <label class="font-weight-bold mb-1">Nome ou Sigla</label>
      <input type="text" name="q" value="<%= q %>" class="form-control" placeholder="Ex: CCJR, Finanças...">
    </div>
    <div class="col-md-4 mb-2">
      <label class="font-weight-bold mb-1">Natureza</label>
      <select name="natureza" class="form-control">
        <option value="">Todas</option>
        <option value="P" <%= natureza === 'P' ? 'selected' : '' %>>Permanente</option>
        <option value="T" <%= natureza === 'T' ? 'selected' : '' %>>Temporária</option>
      </select>
    </div>
    <div class="col-md-3 mb-2">
      <button type="submit" class="btn btn-primary btn-block">Filtrar</button>
    </div>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-striped table-hover bg-white">
    <thead class="thead-light">
      <tr>
        <th>Sigla</th>
        <th>Nome</th>
        <th>Tipo</th>
        <th>Reuniões</th>
        <th>Situação</th>
      </tr>
    </thead>
    <tbody>
      <% comissoes.forEach(c => { %>
        <tr>
          <td><strong><%= c.sigla %></strong></td>
          <td><a href="/comissao/<%= c.id %>" class="font-weight-bold"><%= c.nome %></a></td>
          <td><%= c.tipo %></td>
          <td class="small"><%= c.agenda_reuniao %> — <%= c.local_reuniao %></td>
          <td><span class="badge <%= c.ativa ? 'badge-success' : 'badge-secondary' %>"><%= c.ativa ? 'Ativa' : 'Inativa' %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
