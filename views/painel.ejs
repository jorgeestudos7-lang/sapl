<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="icon" href="/static/sapl/frontend/img/favicon.ico">
  <link rel="stylesheet" href="/static/sapl/frontend/css/chunk-vendors.045ec640.css">
  <link rel="stylesheet" href="/static/sapl/frontend/css/global.042f6737.css">
  <link rel="stylesheet" href="/static/sapl/frontend/css/painel.e2b9504e.css">
</head>
<body class="painel-principal text-white mb-0">
  <div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom border-secondary pb-3 mb-3">
      <div class="d-flex align-items-center">
        <img src="/static/sapl/frontend/img/brasao_transp.gif" alt="Brasão" class="logo-painel mr-3" style="height: 64px;">
        <div>
          <div class="text-title h3 mb-0"><%= casa.nome %></div>
          <div class="text-subtitle h5 mb-0" id="painel-sessao-nome"><%= sessao.__str__ %></div>
        </div>
      </div>
      <div class="text-right">
        <div class="data-hora font-weight-bold" id="painel-relogio">--:--:--</div>
        <div class="small text-muted">
          <a href="/sessao/<%= sessao.id %>" class="btn btn-sm btn-outline-light mr-1">Detalhes da Sessão</a>
          <a href="/" class="btn btn-sm btn-outline-secondary">Voltar ao SAPL</a>
        </div>
      </div>
    </div>

    <div class="row painels">
      <div class="col-lg-5 painel">
        <h2 class="text-title h4">Parlamentares Presentes (<span id="num-presentes">0</span>)</h2>
        <div id="parlamentares-lista" class="table-responsive">
          <table class="table table-sm table-dark table-striped mb-0" style="font-size: 16px;">
            <thead>
              <tr>
                <th>Parlamentar</th>
                <th>Partido</th>
                <th>Voto</th>
              </tr>
            </thead>
            <tbody id="presentes-tbody"></tbody>
          </table>
        </div>
      </div>

      <div class="col-lg-4 painel">
        <h2 class="text-title h4">Matéria em Votação</h2>
        <div id="votacao" class="p-3 bg-dark rounded border border-secondary w-100" style="font-size: 18px;">
          <div id="materia-texto" class="text-value font-weight-bold mb-2">Carregando...</div>
          <div id="materia-ementa" class="small text-light mb-3"></div>
          <div class="mb-2"><span class="text-subtitle">Tipo:</span> <span id="tipo-votacao" class="text-value">-</span></div>
          <div class="mb-3"><span class="text-subtitle">Resultado:</span> <span id="tipo-resultado" class="text-value">-</span></div>

          <div class="row text-center">
            <div class="col-4">
              <div class="p-2 rounded bg-success text-white">
                <div class="small">SIM</div>
                <div class="h3 mb-0" id="votos-sim">0</div>
              </div>
            </div>
            <div class="col-4">
              <div class="p-2 rounded bg-danger text-white">
                <div class="small">NÃO</div>
                <div class="h3 mb-0" id="votos-nao">0</div>
              </div>
            </div>
            <div class="col-4">
              <div class="p-2 rounded bg-warning text-dark">
                <div class="small">ABST.</div>
                <div class="h3 mb-0" id="votos-abst">0</div>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-3 p-3 bg-dark rounded border border-secondary" style="font-size: 14px;">
          <div class="text-subtitle mb-2">Registrar Voto Nominal (Simulador)</div>
          <div class="form-row align-items-center">
            <div class="col-6">
              <select id="sim-parlamentar" class="form-control form-control-sm">
                <% parlamentares.forEach(p => { %>
                  <option value="<%= p.id %>"><%= p.nome_parlamentar %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-6 d-flex justify-content-between">
              <button type="button" class="btn btn-sm btn-success" onclick="registrarVoto('Sim')">Sim</button>
              <button type="button" class="btn btn-sm btn-danger" onclick="registrarVoto('Não')">Não</button>
              <button type="button" class="btn btn-sm btn-warning" onclick="registrarVoto('Abstenção')">Abst.</button>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-3 painel">
        <h2 class="text-title h4">Oradores Inscritos</h2>
        <div id="oradores_list" class="p-3 bg-dark rounded border border-secondary w-100" style="font-size: 16px;">
          <ul id="oradores-ul" class="list-unstyled mb-0"></ul>
        </div>
      </div>
    </div>
  </div>

  <script>
    const sessaoId = <%= sessao.id %>;

    function atualizarRelogio() {
      const now = new Date();
      document.getElementById('painel-relogio').textContent = now.toLocaleTimeString('pt-BR');
    }
    setInterval(atualizarRelogio, 1000);
    atualizarRelogio();

    function renderPainel(data) {
      document.getElementById('num-presentes').textContent = data.num_presentes || 0;
      document.getElementById('materia-texto').textContent = data.materia_legislativa_texto || data.msg_painel;
      document.getElementById('materia-ementa').textContent = data.materia_legislativa_ementa || '';
      document.getElementById('tipo-votacao').textContent = data.tipo_votacao || '-';
      document.getElementById('tipo-resultado').textContent = data.tipo_resultado || '-';
      document.getElementById('votos-sim').textContent = data.numero_votos_sim || 0;
      document.getElementById('votos-nao').textContent = data.numero_votos_nao || 0;
      document.getElementById('votos-abst').textContent = data.numero_abstencoes || 0;

      const tbody = document.getElementById('presentes-tbody');
      tbody.innerHTML = '';
      (data.presentes || []).forEach(p => {
        const tr = document.createElement('tr');
        const badgeClass = p.voto === 'Sim' ? 'badge-success' : p.voto === 'Não' ? 'badge-danger' : p.voto ? 'badge-warning' : 'badge-secondary';
        tr.innerHTML = `<td>${p.nome}</td><td>${p.partido}</td><td><span class="badge ${badgeClass}">${p.voto || 'Aguardando'}</span></td>`;
        tbody.appendChild(tr);
      });

      const oradoresUl = document.getElementById('oradores-ul');
      oradoresUl.innerHTML = '';
      (data.oradores || []).forEach(o => {
        const li = document.createElement('li');
        li.className = 'mb-2';
        li.innerHTML = `<span class="badge badge-info mr-2">${o.numero}º</span> ${o.nome}`;
        oradoresUl.appendChild(li);
      });
    }

    async function carregarDadosPainel() {
      try {
        const res = await fetch(`/painel/${sessaoId}/dados`);
        if (res.ok) renderPainel(await res.json());
      } catch (e) {}
    }

    async function registrarVoto(voto) {
      const parlamentarId = document.getElementById('sim-parlamentar').value;
      const res = await fetch(`/painel/${sessaoId}/votar`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ parlamentar_id: parlamentarId, voto })
      });
      if (res.ok) renderPainel(await res.json());
    }

    carregarDadosPainel();
    setInterval(carregarDadosPainel, 3000);
  </script>
</body>
</html>
